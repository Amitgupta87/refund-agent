# ──────────────────────────────────────────────────────────────
# Customer Support Agent — environment configuration
# Copy this file to `.env` and fill in ONE provider's API key.
# Everything else has sensible defaults; change them only if needed.
# ──────────────────────────────────────────────────────────────

# --- LLM provider selection ---
# Pick the LLM you have a key for. Each default model is multimodal-capable so
# the agent can see attached photos.
#
# One of: gemini | anthropic | openai
LLM_PROVIDER=gemini

# Gemini (Google AI Studio: https://aistudio.google.com/apikey )
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3-flash-preview
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta

# Anthropic (https://console.anthropic.com)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# OpenAI (https://platform.openai.com)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# OPENAI_BASE_URL=https://api.openai.com/v1   # uncomment to use an OpenAI-compatible proxy

# Max tool-call iterations the agent loop will run before forcing a final answer.
AGENT_MAX_ITERATIONS=8

# --- Backend ---
# Inside docker-compose this is overridden to the shared volume path (/data/refund.db).
DB_PATH=./app/data/refund.db
# Comma-separated list of allowed CORS origins for the API.
CORS_ORIGINS=http://localhost:3000

# --- Auth ---
# Secret used to sign login tokens. Change this for any real deployment.
AUTH_SECRET=dev-only-change-me-in-production
# Admin dashboard credentials (separate from customer accounts).
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123
# Per-IP rate limit applied to /auth/login and /admin/login.
LOGIN_RATE_LIMIT=5/minute

# --- Media upload limits (must align with multimodal LLM capabilities) ---
MEDIA_MAX_IMAGE_BYTES=2097152          # 2 MB
MEDIA_MAX_VIDEO_BYTES=104857600        # 100 MB
MEDIA_MAX_VIDEO_SECONDS=60

# --- Frontend ---
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
